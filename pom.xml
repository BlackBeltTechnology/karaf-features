                                            <ns0:includes>
                                                <ns0:include>*.png</ns0:include>
                                            </ns0:includes>
                                        </ns0:resource>
                                    </ns0:resources>
                                </ns0:configuration>
                            </ns0:execution>
                        </ns0:executions>
                    </ns0:plugin>
                </ns0:plugins>
            </ns0:build>
        </ns0:profile>

        <ns0:profile>
