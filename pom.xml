            <ns0:build>
                <ns0:plugins>
                    <ns0:plugin>
                        <ns0:groupId>org.simplify4u.plugins</ns0:groupId>
                        <ns0:artifactId>sign-maven-plugin</ns0:artifactId>
                        <ns0:version>1.1.0</ns0:version>
                        <ns0:executions>
                            <ns0:execution>
                                <ns0:goals>
                                    <ns0:goal>sign</ns0:goal>
                                </ns0:goals>
                            </ns0:execution>
                        </ns0:executions>
                    </ns0:plugin>
                </ns0:plugins>
            </ns0:build>
        </ns0:profile>

        <ns0:profile>
            <ns0:id>release-central</ns0:id>
            <ns0:build>
                <ns0:plugins>
                    <ns0:plugin>
                        <ns0:groupId>org.apache.maven.plugins</ns0:groupId>
                        <ns0:artifactId>maven-deploy-plugin</ns0:artifactId>
                        <ns0:version>3.0.0</ns0:version>
                        <ns0:configuration>
                            <ns0:skip>true</ns0:skip>
                        </ns0:configuration>
                    </ns0:plugin>

                    <ns0:plugin>
                        <ns0:groupId>org.sonatype.plugins</ns0:groupId>
                        <ns0:artifactId>nexus-staging-maven-plugin</ns0:artifactId>
                        <ns0:version>1.6.13</ns0:version>
                        <ns0:executions>
                            <ns0:execution>
                                <ns0:id>ossrh-deploy</ns0:id>
                                <ns0:phase>deploy</ns0:phase>
                                <ns0:goals>
                                    <ns0:goal>deploy</ns0:goal>
                                </ns0:goals>
                                <ns0:configuration>
                                    <ns0:serverId>ossrh</ns0:serverId>
                                    <ns0:nexusUrl>https://oss.sonatype.org/</ns0:nexusUrl>
                                    <ns0:autoReleaseAfterClose>true</ns0:autoReleaseAfterClose>
                                </ns0:configuration>
                            </ns0:execution>
