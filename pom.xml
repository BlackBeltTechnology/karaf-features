                <ns0:module>karaf-features-apache-poi</ns0:module>
                <ns0:module>karaf-features-apache-arrow</ns0:module>
                <ns0:module>karaf-features-common</ns0:module>
                <ns0:module>karaf-features-bouncycastle</ns0:module>
                <ns0:module>karaf-features-eclipse-emf</ns0:module>
                <ns0:module>karaf-features-eclipse-epsilon</ns0:module>
