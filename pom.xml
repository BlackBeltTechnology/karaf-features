                <ns0:module>karaf-features-google</ns0:module>
                <ns0:module>karaf-features-javassist</ns0:module>
                <ns0:module>karaf-features-jdbc</ns0:module>
                <ns0:module>karaf-features-jxls</ns0:module>
                <ns0:module>karaf-features-subethamail</ns0:module>
                <ns0:module>karaf-features-tinybundles</ns0:module>
