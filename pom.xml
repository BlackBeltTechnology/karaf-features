                                </ns0:goals>
                                <ns0:phase>process-sources</ns0:phase>
                                <ns0:configuration>
                                    <ns0:licenseName>apache_v2</ns0:licenseName>
                                </ns0:configuration>
                            </ns0:execution>
                        </ns0:executions>
                    </ns0:plugin>
                </ns0:plugins>
            </ns0:build>
        </ns0:profile>
    </ns0:profiles>
<repositories><repository><id>judo</id><url>https://repository.judo.technology/repository/maven-judong/</url></repository></repositories></ns0:project>