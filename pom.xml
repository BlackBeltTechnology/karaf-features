        <ns0:profile>
            <ns0:id>generate-github-asciidoc-diagrams</ns0:id>

            <ns0:properties>
                <ns0:asciidoctor.maven.plugin.version>2.2.2</ns0:asciidoctor.maven.plugin.version>
                <ns0:asciidoctorj.version>2.5.5</ns0:asciidoctorj.version>
                <ns0:asciidoctorj.diagram.version>2.2.3</ns0:asciidoctorj.diagram.version>
                <ns0:jruby.version>9.3.4.0</ns0:jruby.version>
            </ns0:properties>

            <ns0:build>
                <ns0:plugins>
                    <ns0:plugin>
                        <ns0:groupId>org.asciidoctor</ns0:groupId>
                        <ns0:artifactId>asciidoctor-maven-plugin</ns0:artifactId>
                        <ns0:version>${asciidoctor.maven.plugin.version}</ns0:version>
                        <ns0:dependencies>
                            
                            <ns0:dependency>
                                <ns0:groupId>org.jruby</ns0:groupId>
                                <ns0:artifactId>jruby-complete</ns0:artifactId>
                                <ns0:version>${jruby.version}</ns0:version>
                            </ns0:dependency>
                            
                            <ns0:dependency>
                                <ns0:groupId>org.asciidoctor</ns0:groupId>
                                <ns0:artifactId>asciidoctorj</ns0:artifactId>
                                <ns0:version>${asciidoctorj.version}</ns0:version>
                            </ns0:dependency>
                            <ns0:dependency>
                                <ns0:groupId>org.asciidoctor</ns0:groupId>
                                <ns0:artifactId>asciidoctorj-diagram</ns0:artifactId>
                                <ns0:version>${asciidoctorj.diagram.version}</ns0:version>
                            </ns0:dependency>
                            
                            <ns0:dependency>
                                <ns0:groupId>org.asciidoctor</ns0:groupId>
                                <ns0:artifactId>asciidoctorj-diagram-plantuml</ns0:artifactId>
                                <ns0:version>1.2022.5</ns0:version>
                            </ns0:dependency>
                            <ns0:dependency>
                                <ns0:groupId>org.asciidoctor</ns0:groupId>
                                <ns0:artifactId>asciidoctorj-diagram-ditaamini</ns0:artifactId>
                                <ns0:version>1.0.3</ns0:version>
                            </ns0:dependency>
                        </ns0:dependencies>
                        <ns0:configuration>
                            <ns0:sourceDirectory>./.github</ns0:sourceDirectory>
                            <ns0:requires>
                                <ns0:require>asciidoctor-diagram</ns0:require>
                            </ns0:requires>
                            <ns0:attributes>
                                
                                
                                
                            </ns0:attributes>
                        </ns0:configuration>
                        <ns0:executions>
                            <ns0:execution>
                                <ns0:id>generate-html-doc</ns0:id>
                                <ns0:phase>generate-resources</ns0:phase>
                                <ns0:goals>
                                    <ns0:goal>process-asciidoc</ns0:goal>
                                </ns0:goals>
                                <ns0:configuration>
                                    <ns0:backend>html5</ns0:backend>
                                    <ns0:attributes>
                                        <ns0:imagesdir>./images</ns0:imagesdir>
                                        <ns0:toc>left</ns0:toc>
                                        <ns0:icons>font</ns0:icons>
                                        <ns0:sectanchors>true</ns0:sectanchors>
                                        <ns0:idprefix />
                                        <ns0:idseparator>-</ns0:idseparator>
                                    </ns0:attributes>
                                </ns0:configuration>
                            </ns0:execution>
                        </ns0:executions>
                    </ns0:plugin>

                    <ns0:plugin>
                        <ns0:artifactId>maven-resources-plugin</ns0:artifactId>
                        <ns0:version>3.3.0</ns0:version>
                        <ns0:executions>
                            <ns0:execution>
