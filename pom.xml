            <ns0:distributionManagement>
                <ns0:snapshotRepository>
                    <ns0:id>judong-nexus-distribution</ns0:id>
                    
                    <ns0:url>https://nexus.judo.technology/repository/maven-judong-snapshots/</ns0:url>
                </ns0:snapshotRepository>
                <ns0:repository>
                    <ns0:id>judong-nexus-distribution</ns0:id>
                    
                    <ns0:url>https://nexus.judo.technology/repository/maven-judong-snapshots/</ns0:url>
                </ns0:repository>
            </ns0:distributionManagement>
